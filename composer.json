{
    "name": "domm98cz/curl",
    "description": "PHP lightweight cURL client",
    "keywords": ["curl", "client", "lightweight"],
    "homepage": "https://Domm.cz",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dominik Procházka",
            "email": "domm98cz@gmail.com",
            "homepage": "https://Domm.cz",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "domm98cz@gmail.com",
        "docs": "https://github.com/Domm98CZ/curl/blob/main/README.md"
    },
    "require": {
        "php": ">=8.1 <8.6",
        "ext-curl": "*",
        "psr/http-message": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "php-http/promise": "^1.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "php-http/psr7-integration-tests": "1.5.1",
        "http-interop/http-factory-tests": "2.3.0"
    },
    "provide": {
        "psr/http-client-implementation": "1.0",
        "psr/http-factory-implementation": "1.0",
        "psr/http-message-implementation": "2.0"
    },
    "autoload": {
        "psr-4": {
            "Domm98CZ\\Curl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Domm98CZ\\Curl\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
    }
}
